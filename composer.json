{
    "name": "dsm/digital-signage-masjid",
    "description": "Digital Signage Masjid built with Slim Framework v4 and PDO SQLite",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "php-di/php-di": "^7.0",
        "slim/php-view": "^3.4",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S 127.0.0.1:8080 -t public",
        "factory-reset": "php bin/factory-reset.php"
    }
}
