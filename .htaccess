Options -Indexes

ErrorDocument 403 /dsm/403
ErrorDocument 404 /dsm/404

RewriteEngine On

# Block direct HTTP access to sensitive configuration and source directories
RewriteRule ^(\.env(\.example)?|\.gitignore|composer\.(json|lock)|phpunit\.xml)$ - [F,L]
RewriteRule ^(config|src|templates|tests|vendor)(/.*)?$ - [F,L]

# Allow already-rewritten requests inside public/
RewriteRule ^public/ - [L]

# Preserve legacy /app/{css,js,img,audio}/... URLs
RewriteRule ^app/(css|js|img|audio)/(.*)$ public/assets/$1/$2 [L]

# Serve /assets/... directly from public/assets/...
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

# Route all other requests through Slim front controller
RewriteRule ^ public/index.php [QSA,L]
